generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectWorkflowType {
  DEVELOPMENT
  DESIGN
  SIMPLE
  CUSTOM
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectMemberSource {
  MANUAL
  TEAM
}

enum TaskType {
  TASK
  BUG
  STORY
  EPIC
  SUBTASK
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model User {
  id           String @id @default(uuid())
  login        String @unique
  email        String @unique
  passwordHash String

  firstName String?
  lastName  String?
  avatarUrl String?
  avatarKey String?
  position  String?
  about     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects Project[] @relation("ProjectCreator")
  createdTeams    Team[]    @relation("TeamCreator")

  projectMemberships ProjectMember[]
  teamMemberships    TeamMember[]

  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")

  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  taskWorkflowMoves TaskWorkflowHistory[] @relation("TaskWorkflowHistoryMovedBy")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  userId    String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId    String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Project {
  id String @id @default(uuid())

  title       String
  key         String  @unique
  description String?

  status   ProjectStatus   @default(ACTIVE)
  priority ProjectPriority @default(MEDIUM)

  startDate   DateTime?
  deadline    DateTime?
  completedAt DateTime?

  workflowType ProjectWorkflowType @default(SIMPLE)

  creatorId String
  creator   User   @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        ProjectMember[]
  teamLink       ProjectTeam?
  workflowStages ProjectWorkflowStage[]

  tasks   Task[]
  sprints Sprint[]

  @@index([creatorId])
  @@index([status])
  @@index([deadline])
  @@map("projects")
}

model ProjectMember {
  id String @id @default(uuid())

  projectId String
  userId    String

  role ProjectRole @default(MEMBER)

  source       ProjectMemberSource @default(MANUAL)
  sourceTeamId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceTeam Team? @relation("ProjectMemberSourceTeam", fields: [sourceTeamId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([sourceTeamId])
  @@map("project_members")
}

model ProjectWorkflowStage {
  id String @id @default(uuid())

  projectId String

  name     String
  position Int

  isStart Boolean @default(false)
  isFinal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]

  movedFromHistories TaskWorkflowHistory[] @relation("TaskMovedFromStage")
  movedToHistories   TaskWorkflowHistory[] @relation("TaskMovedToStage")

  @@unique([projectId, name])
  @@unique([projectId, position])
  @@index([projectId])
  @@index([projectId, isStart])
  @@index([projectId, isFinal])
  @@map("project_workflow_stages")
}

model Team {
  id          String  @id @default(uuid())
  name        String
  description String?
  avatarUrl   String?

  creatorId String
  creator   User   @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  projects ProjectTeam[]

  sourceProjectMembers ProjectMember[] @relation("ProjectMemberSourceTeam")

  @@index([creatorId])
  @@map("teams")
}

model TeamMember {
  id String @id @default(uuid())

  teamId String
  userId String

  role TeamRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model ProjectTeam {
  id String @id @default(uuid())

  projectId String @unique
  teamId    String

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("project_teams")
}

model Sprint {
  id String @id @default(uuid())

  projectId String

  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([projectId])
  @@map("sprints")
}

model Task {
  id String @id @default(uuid())

  projectId       String
  sprintId        String?
  workflowStageId String

  number   Int
  position Int @default(0)

  title       String
  description String?

  type     TaskType     @default(TASK)
  priority TaskPriority @default(MEDIUM)

  storyPoints Int?
  dueDate     DateTime?

  createdById String?
  assigneeId  String?

  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint        Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  workflowStage ProjectWorkflowStage @relation(fields: [workflowStageId], references: [id], onDelete: NoAction)

  createdBy User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  parent   Task?  @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[] @relation("TaskSubtasks")

  comments    TaskComment[]
  attachments TaskAttachment[]

  workflowHistory TaskWorkflowHistory[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([sprintId])
  @@index([workflowStageId])
  @@index([projectId, workflowStageId])
  @@index([workflowStageId, position])
  @@index([assigneeId])
  @@index([createdById])
  @@map("tasks")
}

model TaskWorkflowHistory {
  id String @id @default(uuid())

  taskId String

  fromStageId String?
  toStageId   String?

  fromStageName String?
  toStageName   String

  movedById String?

  previousPosition Int?
  newPosition      Int?

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fromStage ProjectWorkflowStage? @relation("TaskMovedFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   ProjectWorkflowStage? @relation("TaskMovedToStage", fields: [toStageId], references: [id], onDelete: SetNull)

  movedBy User? @relation("TaskWorkflowHistoryMovedBy", fields: [movedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([movedById])
  @@map("task_workflow_history")
}

model TaskComment {
  id String @id @default(uuid())

  taskId   String
  authorId String

  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("task_comments")
}

model TaskAttachment {
  id String @id @default(uuid())

  taskId     String
  uploaderId String

  fileName String
  fileKey  String @unique
  fileUrl  String
  mimeType String?
  size     Int?

  createdAt DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploaderId])
  @@map("task_attachments")
}
